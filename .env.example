# Local PostgreSQL / Drizzle (required by the platform preview)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# SECURITY: never paste keys into chat, logs or commits; rotate immediately if exposed.
# Minus AI Tutor: OpenAI-compatible server-side key (use .env.local or a host secret store; never use NEXT_PUBLIC_)
# OPENAI_API_KEY is also accepted as a fallback.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_STREAMING=true

# Optional Supabase email-link authentication + RLS-backed workspace.
# These two NEXT_PUBLIC_ values are public by design; the service-role key is never used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for secure server-side admin checks and paper uploads. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
